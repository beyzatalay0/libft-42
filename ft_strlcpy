size_t ft_strlcpy(char *dest, const *src, size_t size)
{
    size_t = i;
    i=0;
    
    if(size > 0)
    {
        while(src[i] !='\0')
        {
            dest[i]=src[i];
            i++;
        }
        dest[i]='\0';
    }
    return *dest; 
}

